<?xml version="1.0"?>
<robot name="turtle_robot">

  <!-- BASE LINK: Named turtle1 to automatically attach to the turtlesim world -->
  <link name="turtle1">
    <visual>
      <geometry>
        <!-- The main chassis of the robot -->
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- LEFT WHEEL LINK -->
  <link name="left_wheel">
    <visual>
      <!-- Wheels must be rotated 90 degrees (1.5708 radians) on the X-axis to lay flat -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <!-- LEFT WHEEL JOINT -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="turtle1"/>
    <child link="left_wheel"/>
    <!-- Placed on the left side of the chassis -->
    <origin xyz="0 0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RIGHT WHEEL LINK -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <!-- RIGHT WHEEL JOINT -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="turtle1"/>
    <child link="right_wheel"/>
    <!-- Placed on the right side of the chassis -->
    <origin xyz="0 -0.175 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>